<!-- $description = Professional music production, recording, mixing, and mastering services from Three Arrows Sound. -->
<!-- $pageTitle = nil -->
<!-- $path = nil -->
<!-- $pageId = main-index -->
<!-- $pageScript = <script type='module' src='assets/js/index.js'></script> -->
<!-- @import assets/partials/head -->
</head>

<body id="<!-- $pageId? -->" data-bs-spy="scroll" data-bs-target="#main-nav" data-bs-root-margin="0px 0px -50%">
    <div class="pin-trigger w-100 position-absolute top-100 start-0"></div>
    <!-- @import assets/partials/navigation -->
    <main id="main-content">
        <!-- ******************** INTRO/HEADER ******************** -->
        <div class="pin-wrapper overflow-x-hidden overflow-y-auto">
            <header id="index-header" class="p-0">
                <img class="header-logo" src="assets/media/global/logos/tas-black.svg" alt="Three Arrows Sound Logo">
                <div class="video-wrapper bg-primary">
                    <div class="video-overlay"></div>
                    <video id="header-vid" class="" src="assets/video/header-vid.mp4" type="video/mp4" webkit-playsinline="true" playsinline="true" autoplay loop muted></video>
                    <img class="tas-lines" src="assets/media/global/logos/tas-lines.svg" alt="Lines">
                </div>
                <div class="arrows-wrapper">
                    <span class="top-left"></span>
                    <img class="arrows" src="assets/media/global/logos/tas-arrows-black.svg" alt="Arrows logo">
                    <span class="bottom-right"></span>
                </div>
            </header>
            <!-- ******************** INTRO ******************** -->
            <section id="intro" class="pt-5">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col">
                            <h1 class="intro-xl text-uppercase">PRO MUSIC<br>PRODUCTION</h1>
                            <h2 class="intro-lg text-uppercase text-end">
                                <span class="sub-line-1 d-inline-block w-100"><span class="sub-text-1 d-block" data-speed=".1">FOR INDIE</span></span><br>
                                <span class="sub-line-2 d-inline-block w-100"><span class="sub-text-2 d-block" data-speed="0.6">ARTISTS</span></span>
                            </h2>
                        </div>
                    </div>
                </div>
            </section>
        </div>
        <!-- ******************** ABOUT ******************** -->
        <section id="about" class="bg-primary position-relative z-2">
            <div class="container">
                <div class="row justify-content-center gx-lg-5">
                    <div class="col-lg-5">
                        <div class="about-img-wrapper">
                            <img class="about-img w-100" src="assets/media/index/tas-about-image.webp" alt="Chad Altenberger headshot">
                        </div>
                    </div>
                    <div class="col-lg-7 col-xl-6 text-center text-white">
                        <h2 class="display-3 text-uppercase text-white mb-4">About</h2>
                        <p class="h5 text-white text-uppercase ls-6 mb-4">Chad Altenberger</p>
                        <p>With decades of experience in the music industry, I've refined my skills as a producer, audio engineer, and collaborator. My journey began in my twenties, writing, recording, and touring with indie bands nationwide, where I learned from some of the industry's most creative professionals.</p>
                        <p>Since 2014, I've focused on music production, mixing, and mastering, working with artists worldwide. I specialize in crafting polished, high-quality sounds that capture the unique essence of each project, while staying passionate about bringing artists' visions to life.</p>
                        <a class="btn btn-outline-white w-35 mt-4" href="#contact">Let's Chat</a>
                    </div>
                </div>
            </div>
        </section>
        <!-- ******************** PORTFOLIO ******************** -->
        <section id="portfolio">
            <img class="portfolio-bg" data-speed="0.05" src="assets/media/index/portfolio-bg-expanded-2.webp" alt="">
            <div class="container test">
                <div class="row">
                    <div class="col text-center">
                        <h2 class="display-3 text-uppercase">Portfolio</h2>
                    </div>
                </div>
                <div id="samples-wrapper" class="row justify-content-center row-cols-1 row-cols-md-2 g-3 mt-4" data-speed="-.05">
                    <!-- Audio players rendered via JS: index.js -->
                </div>
            </div>
        </section>
        <!-- ******************** SERVICES ******************** -->
        <section id="services" class="bg-primary" data-speed="0.03">
            <div class="container">
                <div class="row text-white gx-lg-5">
                    <div id="trigger" class="col-lg-4 text-center mb-4 mb-lg-0">
                        <div class="service-title recording position-relative">
                            <!-- @import assets/partials/arrow -->
                            <h2 class="h1 text-white text-uppercase">Recording</h2>
                            <p class="px-5 mt-4">Whether for backing tracks or full band production, I have decades of experience and gear to help craft your songs and capture your sound</p>
                        </div>
                    </div>
                    <div class="col-lg-4 text-center mb-4 mb-lg-0">
                        <div class="service-title mixing position-relative">
                            <!-- @import assets/partials/arrow -->
                            <h2 class="h1 text-white text-uppercase">Mixing</h2>
                            <p class="px-5 mt-4">Send your raw tracks, no matter where they were recorded, and get professional, high-end mixes that rival major commercial releases</p>
                        </div>
                    </div>
                    <div id="spaced-lines-trigger" class="col-lg-4 text-center">
                        <div class="service-title mastering position-relative">
                            <!-- @import assets/partials/arrow -->
                            <h2 class="h1 text-white text-uppercase">Mastering</h2>
                            <p class="px-5 mt-4">Send your final mix, and get a meticulously enhanced, radio-ready track that ensures your music shines with clarity and impact</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="spaced-lines">
                <img class="spaced-line-1" src="assets/media/index/spaced-lines/line-1.svg" alt="">
                <img class="spaced-line-2" src="assets/media/index/spaced-lines/line-2.svg" alt="">
                <img class="spaced-line-3" src="assets/media/index/spaced-lines/line-3.svg" alt="">
                <img class="spaced-line-4" src="assets/media/index/spaced-lines/line-4.svg" alt="">
                <img class="spaced-line-5" src="assets/media/index/spaced-lines/line-5.svg" alt="">
            </div>
        </section>
        <!-- ******************** CONTACT FORM ******************** -->
        <section id="contact">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-10 text-center">
                        <h2 class="display-3 text-uppercase mb-4">Let's Chat</h2>
                        <p class="lead">Please complete the form below to request a quote or for general inquiries</p>
                    </div>
                    <div class="col-lg-8 mt-5">
                        <form id="contact-form" action="https://formsubmit.co/9bfc5db7d1f6cee4e7cc8fdc6bb08b07" method="POST">
                            <input type="hidden" name="_next" value="https://www.threearrowssound.com/thank-you.html">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label font-secondary text-uppercase" for="first-name">Name <span class="text-secondary">*</span></label>
                                        <input id="first-name" class="form-control border-primary" type="text" name="Name" aria-label="Field to enter first name" required>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label font-secondary text-uppercase" for="email">Email <span class="text-secondary">*</span></label>
                                        <input id="email" class="form-control border-primary" type="email" name="Email" aria-label="Field to enter email" required>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="mb-3">
                                        <label class="form-label font-secondary text-uppercase" for="subject">Subject <span class="text-secondary">*</span></label>
                                        <input id="subject" class="form-control border-primary" type="text" name="Subject" aria-label="Field to enter subject" required>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="mb-3">
                                        <label class="form-label font-secondary text-uppercase" for="message">Message</label>
                                        <textarea id="message" class="form-control border-primary" type="text" name="Message" rows="4" cols="35"></textarea>
                                    </div>
                                </div>
                            </div>
                            <button class="btn btn-lg btn-outline-primary w-30 w-lg-25" type="submit">Submit</button>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    </main>
    <!-- @import assets/partials/footer -->
</body>

</html>